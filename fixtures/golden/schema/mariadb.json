{
  "engine": "mariadb",
  "schema": "barsql_golden",
  "setup": [
    "DROP DATABASE IF EXISTS barsql_golden",
    "CREATE DATABASE barsql_golden DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci",
    "CREATE TABLE barsql_golden.customers (\n\t\t\tid INT AUTO_INCREMENT PRIMARY KEY,\n\t\t\temail VARCHAR(255) NOT NULL,\n\t\t\tname VARCHAR(100) NOT NULL DEFAULT 'anon',\n\t\t\tmood ENUM('sad', 'happy') NULL,\n\t\t\tcreated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n\t\t\tUNIQUE KEY customers_email_uq (email),\n\t\t\tCONSTRAINT customers_name_check CHECK (CHAR_LENGTH(name) > 0)\n\t\t) ENGINE=InnoDB COMMENT='Customers'",
    "CREATE TABLE barsql_golden.orders (\n\t\t\tid BIGINT AUTO_INCREMENT PRIMARY KEY,\n\t\t\tcustomer_id INT NOT NULL,\n\t\t\ttotal DECIMAL(12,2) NOT NULL DEFAULT 0,\n\t\t\tstatus VARCHAR(20) NOT NULL DEFAULT 'new',\n\t\t\ttotal_with_tax DECIMAL(12,2) AS (total * 1.2) STORED,\n\t\t\tKEY orders_customer_idx (customer_id),\n\t\t\tCONSTRAINT orders_customer_fk FOREIGN KEY (customer_id) REFERENCES barsql_golden.customers (id) ON DELETE CASCADE\n\t\t) ENGINE=InnoDB",
    "CREATE INDEX orders_status_idx ON barsql_golden.orders (status, customer_id)",
    "CREATE VIEW barsql_golden.customer_totals AS SELECT c.id, c.email, COALESCE(SUM(o.total), 0) AS total FROM barsql_golden.customers c LEFT JOIN barsql_golden.orders o ON o.customer_id = c.id GROUP BY c.id, c.email",
    "CREATE TRIGGER barsql_golden.orders_touch BEFORE INSERT ON barsql_golden.orders FOR EACH ROW SET NEW.status = LOWER(NEW.status)",
    "CREATE FUNCTION barsql_golden.add_one(a INT) RETURNS INT DETERMINISTIC RETURN a + 1",
    "CREATE PROCEDURE barsql_golden.reset_status(IN target VARCHAR(20)) UPDATE barsql_golden.orders SET status = target",
    "INSERT INTO barsql_golden.customers (email, name, mood, created_at) VALUES ('a@x.io', 'Ann', 'happy', '2024-01-01 10:00:00'), ('b@x.io', 'Bob', 'sad', '2024-01-02 11:30:00')",
    "INSERT INTO barsql_golden.orders (customer_id, total, status) VALUES (1, 10.50, 'NEW'), (1, 5, 'Paid'), (2, 7.25, 'new')",
    "CREATE TABLE barsql_golden.types (\n\t\t\tid INT PRIMARY KEY,\n\t\t\tc_tinyint TINYINT, c_bool BOOLEAN, c_smallint SMALLINT, c_mediumint MEDIUMINT, c_int INT,\n\t\t\tc_bigint BIGINT, c_ubigint BIGINT UNSIGNED, c_decimal DECIMAL(20,5), c_float FLOAT, c_double DOUBLE,\n\t\t\tc_bit BIT(4), c_char CHAR(4), c_varchar VARCHAR(20), c_text TEXT, c_blob BLOB, c_binary BINARY(4),\n\t\t\tc_varbinary VARBINARY(8), c_date DATE, c_datetime DATETIME(6), c_timestamp TIMESTAMP(3) NULL,\n\t\t\tc_time TIME(3), c_year YEAR, c_json JSON, c_enum ENUM('sad', 'happy'), c_set SET('a', 'b', 'c'),\n\t\t\tc_point POINT, c_uuid UUID, c_inet6 INET6\n\t\t)",
    "INSERT INTO barsql_golden.types (id, c_tinyint, c_bool, c_smallint, c_mediumint, c_int, c_bigint, c_ubigint,\n\t\t\tc_decimal, c_float, c_double, c_bit, c_char, c_varchar, c_text, c_blob, c_binary, c_varbinary, c_date,\n\t\t\tc_datetime, c_timestamp, c_time, c_year, c_json, c_enum, c_set, c_point, c_uuid, c_inet6) VALUES\n\t\t\t(1, 127, TRUE, 32767, 8388607, 2147483647, 9007199254740993, 18446744073709551615, 12345.67890, 1.1, 0.1,\n\t\t\t b'1010', 'ab', 'héllo 🌍', 'line1\\nline2', 'blob-utf8', 'abcd', X'DEADBEEF', '2024-02-29',\n\t\t\t '2024-02-29 13:45:30.123456', '2024-02-29 13:45:30.123', '13:45:30.123', 2024, '{\"b\": 1, \"a\": [1, 2]}',\n\t\t\t 'happy', 'a,c', ST_GeomFromText('POINT(1 2)'), '123e4567-e89b-12d3-a456-426614174000', '::ffff:192.168.0.1'),\n\t\t\t(2, -128, FALSE, -32768, -8388608, -2147483648, -9223372036854775808, 0, -0.00001, 3.40282e38, 1e21,\n\t\t\t b'0000', '', '', '', X'00FF', X'00000000', X'', '1000-01-01', '9999-12-31 23:59:59.999999',\n\t\t\t '1970-01-01 00:00:01.000', '-838:59:59.000', 1901, '[]', 'sad', '', ST_GeomFromText('POINT(0 0)'), '00000000-0000-0000-0000-000000000000', '::1')",
    "INSERT INTO barsql_golden.types (id) VALUES (3)",
    "SET SESSION sql_mode = ''",
    "INSERT INTO barsql_golden.types (id, c_date, c_datetime) VALUES (4, '0000-00-00', '0000-00-00 00:00:00')",
    "SET SESSION sql_mode = DEFAULT"
  ],
