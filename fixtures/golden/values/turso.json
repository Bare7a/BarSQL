{
  "engine": "turso",
  "setup": [
    "CREATE TABLE customers (\n\t\tid INTEGER PRIMARY KEY AUTOINCREMENT,\n\t\temail TEXT NOT NULL UNIQUE,\n\t\tname TEXT NOT NULL DEFAULT 'anon' CHECK (length(name) > 0),\n\t\tcreated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP\n\t)",
    "CREATE TABLE orders (\n\t\tid INTEGER PRIMARY KEY,\n\t\tcustomer_id INTEGER NOT NULL REFERENCES customers (id) ON DELETE CASCADE,\n\t\ttotal NUMERIC NOT NULL DEFAULT 0,\n\t\tstatus TEXT NOT NULL DEFAULT 'new',\n\t\ttotal_with_tax NUMERIC GENERATED ALWAYS AS (total * 1.2) STORED\n\t)",
    "CREATE INDEX orders_customer_idx ON orders (customer_id)",
    "CREATE UNIQUE INDEX orders_status_partial_idx ON orders (customer_id, status) WHERE status <> 'cancelled'",
    "CREATE VIEW customer_totals AS SELECT c.id, c.email, coalesce(sum(o.total), 0) AS total FROM customers c LEFT JOIN orders o ON o.customer_id = c.id GROUP BY c.id, c.email",
    "CREATE TRIGGER orders_touch AFTER INSERT ON orders BEGIN UPDATE orders SET status = lower(NEW.status) WHERE id = NEW.id; END",
    "INSERT INTO customers (email, name, created_at) VALUES ('a@x.io', 'Ann', '2024-01-01 10:00:00'), ('b@x.io', 'Bob', '2024-01-02 11:30:00')",
    "INSERT INTO orders (customer_id, total, status) VALUES (1, 10.50, 'NEW'), (1, 5, 'Paid'), (2, 7.25, 'new')",
    "CREATE TABLE types (\n\t\tid INTEGER PRIMARY KEY, c_integer INTEGER, c_bigint BIGINT, c_real REAL, c_double DOUBLE,\n\t\tc_numeric NUMERIC, c_decimal DECIMAL(10,2), c_boolean BOOLEAN, c_text TEXT, c_varchar VARCHAR(20),\n\t\tc_blob BLOB, c_date DATE, c_datetime DATETIME, c_timestamp TIMESTAMP, c_time TIME, c_json JSON, c_untyped\n\t)",
