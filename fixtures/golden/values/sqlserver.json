{
  "engine": "sqlserver",
  "serverVersion": "15.0 (Azure SQL Edge); CI runs 2022",
  "setup": [
    "DROP VIEW IF EXISTS barsql_golden.customer_totals",
    "DROP TABLE IF EXISTS barsql_golden.orders",
    "DROP TABLE IF EXISTS barsql_golden.customers",
    "DROP TABLE IF EXISTS barsql_golden.items",
    "DROP FUNCTION IF EXISTS barsql_golden.with_tax",
    "DROP PROCEDURE IF EXISTS barsql_golden.count_orders",
    "DROP SCHEMA IF EXISTS barsql_golden",
    "CREATE SCHEMA barsql_golden",
    "CREATE TABLE barsql_golden.customers (\n    id int IDENTITY(1, 1) CONSTRAINT pk_customers PRIMARY KEY,\n    email nvarchar(255) NOT NULL CONSTRAINT uq_customers_email UNIQUE,\n    name nvarchar(100) NOT NULL CONSTRAINT df_customers_name DEFAULT N'anon',\n    created_at datetime2(3) NOT NULL CONSTRAINT df_customers_created DEFAULT SYSUTCDATETIME(),\n    CONSTRAINT ck_customers_name CHECK (LEN(name) > 0)\n)",
    "CREATE TABLE barsql_golden.orders (\n    id int NOT NULL CONSTRAINT pk_orders PRIMARY KEY,\n    customer_id int NOT NULL CONSTRAINT fk_orders_customer REFERENCES barsql_golden.customers (id) ON DELETE CASCADE,\n    total decimal(10, 2) NOT NULL CONSTRAINT df_orders_total DEFAULT 0,\n    status varchar(20) NOT NULL CONSTRAINT df_orders_status DEFAULT 'new',\n    total_with_tax AS (total * 1.2) PERSISTED,\n    note nvarchar(max) NULL\n)",
    "CREATE INDEX ix_orders_customer ON barsql_golden.orders (customer_id) INCLUDE (total)",
    "CREATE UNIQUE INDEX ux_orders_status ON barsql_golden.orders (customer_id, status) WHERE status <> 'cancelled'",
    "CREATE VIEW barsql_golden.customer_totals AS SELECT c.id, c.email, COALESCE(SUM(o.total), 0) AS total FROM barsql_golden.customers c LEFT JOIN barsql_golden.orders o ON o.customer_id = c.id GROUP BY c.id, c.email",
    "CREATE TRIGGER barsql_golden.orders_touch ON barsql_golden.orders AFTER INSERT AS UPDATE o SET status = LOWER(o.status) FROM barsql_golden.orders o JOIN inserted i ON i.id = o.id",
    "CREATE FUNCTION barsql_golden.with_tax(@total decimal(10, 2)) RETURNS decimal(12, 2) AS BEGIN RETURN @total * 1.2 END",
    "CREATE PROCEDURE barsql_golden.count_orders @status varchar(20) AS SELECT COUNT(*) AS n FROM barsql_golden.orders WHERE status = @status",
    "INSERT INTO barsql_golden.customers (email, name, created_at) VALUES ('a@x.io', N'Ann', '2024-01-01T10:00:00'), ('b@x.io', N'Bob', '2024-01-02T11:30:00')",
    "INSERT INTO barsql_golden.orders (id, customer_id, total, status) VALUES (1, 1, 10.50, 'NEW'), (2, 1, 5, 'Paid'), (3, 2, 7.25, 'new')",
    "CREATE TABLE barsql_golden.items (n int NOT NULL)",
    "INSERT INTO barsql_golden.items VALUES (1), (2), (3)"
  ],
